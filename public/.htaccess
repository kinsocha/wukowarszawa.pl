# =====================================================================
# .htaccess - konfiguracja serwera dla wukowarszawa.pl (Astro, statyczny HTML)
# =====================================================================
# Plik trafia do /public_html/ na serwerze automatycznie (Astro kopiuje
# zawartość /public/ do /dist/ przy buildzie).
#
# Zmiana 2026-09-04: usunięty fallback SPA z czasów React Routera. Każda
# podstrona ma teraz własny katalog z index.html, więc nieistniejący adres
# ma zwracać prawdziwy 404, a nie stronę główną z kodem 200 (GSC zgłaszał
# takie adresy jako duplikaty strony głównej).

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ---------------------------------------------------------------------
  # 1. Jeden adres kanoniczny: https://wukowarszawa.pl (bez www, bez http)
  # ---------------------------------------------------------------------
  RewriteCond %{HTTP_HOST} ^www\.wukowarszawa\.pl$ [NC]
  RewriteRule ^(.*)$ https://wukowarszawa.pl/$1 [R=301,L]

  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://wukowarszawa.pl/$1 [R=301,L]

  # ---------------------------------------------------------------------
  # 2. Stare adresy .html z dawnej strony -> nowe adresy (jeden skok 301,
  #    od razu na wersję z ukośnikiem, którą serwer zwraca jako 200)
  # ---------------------------------------------------------------------
  RewriteRule ^wukotargowek\.html$ /wukotargowek/ [R=301,L]
  RewriteRule ^wukobialoleka\.html$ /wukobialoleka/ [R=301,L]
  RewriteRule ^wukobielany\.html$ /wukobielany/ [R=301,L]
  RewriteRule ^wukobrodno\.html$ /wukobrodno/ [R=301,L]
  RewriteRule ^wukowawer\.html$ /wukowawer/ [R=301,L]
  RewriteRule ^wukoochota\.html$ /wukoochota/ [R=301,L]
  RewriteRule ^wukopragapolnoc\.html$ /wukopragapolnoc/ [R=301,L]
  RewriteRule ^wukopragapoludnie\.html$ /wukopragapoludnie/ [R=301,L]
  RewriteRule ^wukorembertow\.html$ /wukorembertow/ [R=301,L]
  RewriteRule ^wukoursus\.html$ /wukoursus/ [R=301,L]

  # Dawna strona zbiorcza ulic i dawne opinie
  RewriteRule ^wuko-warszawa\.html$ / [R=301,L]
  RewriteRule ^reviews\.html$ /opinie/ [R=301,L]
</IfModule>

# ---------------------------------------------------------------------
# 3. Własna strona błędu 404 (generowana przez Astro z src/pages/404.astro)
# ---------------------------------------------------------------------
ErrorDocument 404 /404.html

# ---------------------------------------------------------------------
# 4. Kompresja Gzip
# ---------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/xml text/xml image/svg+xml
</IfModule>

# ---------------------------------------------------------------------
# 5. Cache statycznych plików
# ---------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On

  # HTML - zawsze świeże
  ExpiresByType text/html "access plus 0 seconds"

  # CSS i JS - Astro dodaje hash do nazwy pliku, więc rok jest bezpieczny
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"

  # Obrazy
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"

  # Wideo
  ExpiresByType video/mp4 "access plus 1 month"

  # Fonty
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# ---------------------------------------------------------------------
# 6. Nagłówki bezpieczeństwa
# ---------------------------------------------------------------------
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ---------------------------------------------------------------------
# 7. Domyślny dokument
# ---------------------------------------------------------------------
DirectoryIndex index.html
