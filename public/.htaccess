# =====================================================================
# .htaccess - wukowarszawa.pl (Astro, statyczny HTML, Seohost/LiteSpeed)
# =====================================================================
# Plik trafia do /public_html/ automatycznie (Astro kopiuje /public/ do /dist/).
#
# Konwencja adresów (2026-09-04, jak na i-hydraulik.pl i udraznianiekanalizacji.eu):
# adres BEZ ukośnika na końcu zwraca 200, wersja z ukośnikiem daje 301 na wersję bez.
# Astro buduje /podstrona/index.html, a reguła w sekcji 4 serwuje ten plik
# pod adresem /podstrona bez przekierowania.

Options -MultiViews -Indexes
DirectorySlash Off

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ---------------------------------------------------------------------
  # 1. Jeden host: https://wukowarszawa.pl (bez www, bez http)
  # ---------------------------------------------------------------------
  RewriteCond %{HTTP_HOST} ^www\.wukowarszawa\.pl$ [NC]
  RewriteRule ^(.*)$ https://wukowarszawa.pl/$1 [R=301,L]

  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://wukowarszawa.pl/$1 [R=301,L]

  # ---------------------------------------------------------------------
  # 2. Stare adresy .html z dawnej strony -> nowe (jeden skok 301)
  # ---------------------------------------------------------------------
  RewriteRule ^wukotargowek\.html$ /wukotargowek [R=301,L]
  RewriteRule ^wukobialoleka\.html$ /wukobialoleka [R=301,L]
  RewriteRule ^wukobielany\.html$ /wukobielany [R=301,L]
  RewriteRule ^wukobrodno\.html$ /wukobrodno [R=301,L]
  RewriteRule ^wukowawer\.html$ /wukowawer [R=301,L]
  RewriteRule ^wukoochota\.html$ /wukoochota [R=301,L]
  RewriteRule ^wukopragapolnoc\.html$ /wukopragapolnoc [R=301,L]
  RewriteRule ^wukopragapoludnie\.html$ /wukopragapoludnie [R=301,L]
  RewriteRule ^wukorembertow\.html$ /wukorembertow [R=301,L]
  RewriteRule ^wukoursus\.html$ /wukoursus [R=301,L]
  RewriteRule ^wuko-warszawa\.html$ / [R=301,L]
  RewriteRule ^reviews\.html$ /opinie [R=301,L]

  # ---------------------------------------------------------------------
  # 3. Ukośnik na końcu -> 301 na adres bez ukośnika
  # ---------------------------------------------------------------------
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # ---------------------------------------------------------------------
  # 4. /podstrona -> wewnętrznie /podstrona/index.html (bez przekierowania)
  # ---------------------------------------------------------------------
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.*?)/?$ $1/index.html [L]
</IfModule>

# ---------------------------------------------------------------------
# 5. Własna strona 404 (src/pages/404.astro -> /404.html)
# ---------------------------------------------------------------------
ErrorDocument 404 /404.html

# ---------------------------------------------------------------------
# 6. Kompresja
# ---------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/xml text/xml image/svg+xml
</IfModule>

# ---------------------------------------------------------------------
# 7. Cache statycznych plików
# ---------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType video/mp4 "access plus 1 month"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# ---------------------------------------------------------------------
# 8. Nagłówki bezpieczeństwa
# ---------------------------------------------------------------------
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

DirectoryIndex index.html
