    font-size: 1.875rem;
    font-weight: 700;
    color: #0f172a;
    margin-bottom: 1rem;
  }
  @media (min-width: 640px) { .cp-title { font-size: 2.25rem; } }
  @media (min-width: 1024px) { .cp-title { font-size: 2.75rem; } }
  .cp-sub { font-size: 1.125rem; color: #475569; max-width: 40rem; margin: 0 auto; }

  .cp-body p {
    font-size: 1.125rem;
    color: #475569;
    line-height: 1.8;
    margin-bottom: 1.5rem;
  }
  .cp-h3 {
    font-size: 1.375rem;
    font-weight: 700;
    color: #0f172a;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }
  .cp-list {
    list-style: disc;
    margin: 0 0 1.5rem 1.5rem;
    font-size: 1.125rem;
    color: #475569;
    line-height: 1.8;
  }
  .cp-list li { margin-bottom: 0.5rem; }
  .cp-figure { margin: 2.5rem auto; max-width: 28rem; }
  .cp-figure img {
    width: 100%;
    height: auto;
    border-radius: 1rem;
    box-shadow: 0 12px 32px rgba(15, 23, 42, 0.12);
  }
  .cp-figure figcaption {
    margin-top: 0.75rem;
    font-size: 0.9375rem;
    color: #64748b;
    text-align: center;
  }

  .cp-link { color: #0284c7; font-weight: 600; text-decoration: none; }
  .cp-link:hover { text-decoration: underline; }

  .cp-cta {
    margin-top: 3rem;
    background: #fff;
    border: 1px solid #e0f2fe;
    border-radius: 1.25rem;
    padding: 2rem;
    text-align: center;
  }
  .cp-cta-text {
    font-size: 1.125rem;
    color: #334155;
    line-height: 1.8;
    margin-bottom: 1.75rem;
  }
  .cp-call {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: linear-gradient(90deg, var(--sky), var(--cyan));
    color: #fff;
    padding: 1rem 2rem;
    border-radius: 999px;
    font-size: 1.125rem;
    font-weight: 700;
    text-decoration: none;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .cp-call:hover { transform: scale(1.05); box-shadow: 0 20px 40px rgba(14, 165, 233, 0.3); }
</style>
