    padding: 0 1rem;
  }
  @media (min-width: 640px) { .cp-inner { padding: 0 1.5rem; } }
  @media (min-width: 1024px) { .cp-inner { padding: 0 2rem; } }

  .cp-head { text-align: center; margin-bottom: 3rem; }
