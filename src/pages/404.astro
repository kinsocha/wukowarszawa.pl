---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../config/site';
---
<Layout title="Strona nie istnieje (404) | Wuko Warszawa" description="Taki adres nie istnieje na wukowarszawa.pl. Przejdź na stronę główną albo zadzwoń – udrażniamy kanalizację w całej Warszawie.">
  <section class="nf">
    <div class="nf-inner">
      <p class="nf-code">404</p>
      <h1 class="nf-h1">Takiej strony tu nie ma</h1>
      <p class="nf-p">Adres mógł się zmienić albo został wpisany z błędem. Kanalizacja i tak czeka – wybierz, dokąd przejść.</p>
      <div class="nf-links">
        <a href="/" class="nf-btn">Strona główna</a>
        <a href="/poradnik/" class="nf-btn nf-btn-ghost">Poradnik i realizacje</a>
        <a href={`tel:${siteConfig.phoneTel}`} class="nf-btn nf-btn-ghost">Zadzwoń: {siteConfig.phone}</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .nf {
    padding: 6rem 1.25rem;
    background: #f8fafc;
  }
  .nf-inner {
    max-width: 40rem;
    margin: 0 auto;
    text-align: center;
  }
  .nf-code {
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: #0284c7;
    margin: 0 0 0.75rem;
  }
  .nf-h1 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    margin: 0 0 1rem;
    color: #0f172a;
  }
  .nf-p {
    font-size: 1.0625rem;
    line-height: 1.6;
    color: #334155;
    margin: 0 0 2rem;
  }
  .nf-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
  }
  .nf-btn {
    display: inline-block;
    padding: 0.8rem 1.4rem;
    border-radius: 0.75rem;
    background: #0284c7;
    color: #fff;
    font-weight: 600;
    text-decoration: none;
    font-size: 1rem;
  }
  .nf-btn-ghost {
    background: #fff;
    color: #0f172a;
    border: 1px solid #cbd5e1;
  }
</style>
